TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

# Secret utilisé pour signer les tokens JWT (access token) — changez cette
# valeur pour toute utilisation réelle, une chaîne aléatoire suffit
JWT_SECRET=change-me-with-a-long-random-string

# Base de données PostgreSQL — démarrée en local via `docker compose up -d`
# (correspond aux identifiants définis dans docker-compose.yml)
DATABASE_URL="postgresql://finygo:finygo@localhost:5433/finygo"
DB_HOST=localhost
DB_PORT=5433
DB_USER=finygo
DB_PASSWORD=finygo
DB_DATABASE=finygo